{
  "name": "luke-app",
  "version": "1.0.0",
  "description": "WhatsApp bot to track expenses (Apple Pay + voice notes)",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "start": "node --env-file-if-exists=.env --import tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:up": "docker compose up -d db",
    "db:generate": "drizzle-kit generate"
  },
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@hono/node-server": "^2.1.3",
    "@kapso/whatsapp-cloud-api": "^0.3.0",
    "croner": "^10.0.1",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.13",
    "postgres": "^3.4.9",
    "tsx": "^4.23.15",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "drizzle-kit": "^0.31.11",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  },
  "engines": {
    "node": ">=22"
  }
}
