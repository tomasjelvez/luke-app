# --- Servidor ---
PORT=3000

# --- Base de datos (local: npm run db:up) ---
DATABASE_URL=postgres://luke:luke@localhost:5433/luke

# --- Kapso (https://app.kapso.ai) ---
KAPSO_API_KEY=
# ID del número de WhatsApp (sandbox o producción) desde el dashboard de Kapso
KAPSO_PHONE_NUMBER_ID=
# Secreto que configuras al crear el webhook en Kapso
KAPSO_WEBHOOK_SECRET=

# --- Claude ---
ANTHROPIC_API_KEY=
# Modelo para interpretar mensajes (por defecto claude-opus-5)
# LLM_MODEL=claude-opus-5

# --- Dueño del bot (MVP de un solo usuario) ---
# Tu número de WhatsApp en formato internacional sin "+" (ej. 61412345678)
OWNER_PHONE=
OWNER_TIMEZONE=Australia/Sydney
OWNER_CURRENCY=AUD
# Token secreto que usará el Atajo de Apple Pay (genera uno con: openssl rand -hex 24)
APPLE_PAY_TOKEN=

# Hora del resumen nocturno (en la zona horaria del dueño)
NIGHTLY_HOUR=21
