# --- Server ---
PORT=3000
# Public URL (WhatsApp links, secure cookies). Locally: http://localhost:3000
PUBLIC_URL=http://localhost:3000

# --- Database (local: npm run db:up) ---
DATABASE_URL=postgres://luke:luke@localhost:5433/luke

# --- Kapso (https://app.kapso.ai) ---
KAPSO_API_KEY=
# WhatsApp phone number ID (sandbox or production) from the Kapso dashboard
KAPSO_PHONE_NUMBER_ID=
# Secret you set when creating the webhook in Kapso
KAPSO_WEBHOOK_SECRET=
# Luke's WhatsApp number, digits only (for the sign-up wa.me links)
WHATSAPP_BOT_NUMBER=

# --- Claude ---
ANTHROPIC_API_KEY=
# Model used to interpret messages (default claude-opus-5)
# LLM_MODEL=claude-opus-5

# --- Accounts ---
# User cap while sign-up is open
MAX_USERS=20
# Hour of the nightly summary (in each user's time zone)
NIGHTLY_HOUR=21

# --- Shared Apple Pay Shortcut (see README) ---
# iCloud link to the Shortcut. If unset, /cuenta/apple-pay shows only the manual setup.
# APPLE_PAY_SHORTCUT_URL=https://www.icloud.com/shortcuts/...
# Exact Shortcut name (the web page opens it by name)
# APPLE_PAY_SHORTCUT_NAME=Luke Apple Pay

# --- Legacy single-user MVP (optional) ---
# If set, the Apple Pay token is linked to that number's account at startup.
# OWNER_PHONE=
# APPLE_PAY_TOKEN=
