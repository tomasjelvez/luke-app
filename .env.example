# --- Servidor ---
PORT=3000
# URL pública (links de WhatsApp, cookies seguras). En local: http://localhost:3000
PUBLIC_URL=http://localhost:3000

# --- Base de datos (local: npm run db:up) ---
DATABASE_URL=postgres://luke:luke@localhost:5433/luke

# --- Kapso (https://app.kapso.ai) ---
KAPSO_API_KEY=
# ID del número de WhatsApp (sandbox o producción) desde el dashboard de Kapso
KAPSO_PHONE_NUMBER_ID=
# Secreto que configuras al crear el webhook en Kapso
KAPSO_WEBHOOK_SECRET=
# Número de WhatsApp de Luke, solo dígitos (para los links wa.me del registro)
WHATSAPP_BOT_NUMBER=

# --- Claude ---
ANTHROPIC_API_KEY=
# Modelo para interpretar mensajes (por defecto claude-opus-5)
# LLM_MODEL=claude-opus-5

# --- Cuentas ---
# Tope de usuarios mientras el registro sea abierto
MAX_USERS=20
# Hora del resumen nocturno (en la zona horaria de cada usuario)
NIGHTLY_HOUR=21

# --- Atajo compartido de Apple Pay (ver README) ---
# Link de iCloud del Atajo. Si no está, /cuenta/apple-pay muestra solo la configuración manual.
# APPLE_PAY_SHORTCUT_URL=https://www.icloud.com/shortcuts/...
# Nombre exacto del Atajo (la web lo abre por nombre)
# APPLE_PAY_SHORTCUT_NAME=Luke Apple Pay

# --- Legado del MVP de un solo usuario (opcional) ---
# Si están definidas, el token de Apple Pay se asocia a la cuenta de ese número al arrancar.
# OWNER_PHONE=
# APPLE_PAY_TOKEN=
